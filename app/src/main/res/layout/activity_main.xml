<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- 取景區：圓角卡片，左上角顯示測光讀數 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="12dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@android:color/black"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.example.mcamera.AutoFitTextureView
                android:id="@+id/tv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMeter"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="12dp"
                android:clickable="false"
                android:focusable="false"
                android:text="測光 —"
                android:textColor="?attr/colorOnSurface"
                app:chipBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:chipStrokeWidth="0dp" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 控制區 -->
    <com.google.android.material.card.MaterialCardView
        style="?attr/materialCardViewFilledStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tgSel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:checkedButton="@id/tileShutter"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tileFocus"
                    style="@style/Widget.MCamera.Tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="對焦\nAF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tileShutter"
                    style="@style/Widget.MCamera.Tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="快門\n—" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tileIso"
                    style="@style/Widget.MCamera.Tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ISO\n—" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tileComp"
                    style="@style/Widget.MCamera.Tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="補償\n+0.0" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.slider.Slider
                android:id="@+id/slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:valueFrom="0"
                android:valueTo="1000"
                app:labelBehavior="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/tgMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="invisible"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnA"
                        style="@style/Widget.MCamera.Seg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AF" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnB"
                        style="@style/Widget.MCamera.Seg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MF" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                    android:id="@+id/fab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="拍照"
                    app:icon="@drawable/ic_camera" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
